{
  "name": "ai4-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8080 -c ai4eosc-production",
    "build-ai4eosc-dev-1": "ng build --configuration ai4eosc-development-1",
    "build-ai4eosc-dev": "ng build --configuration ai4eosc-development",
    "build-ai4eosc-stage": "ng build --configuration ai4eosc-stage",
    "build-ai4eosc-prod": "ng build --configuration ai4eosc-production",
    "build-imagine-dev": "ng build --configuration imagine-development",
    "build-imagine-prod": "ng build --configuration imagine-production",
    "build-tutorials-prod": "ng build --configuration tutorials-production",
    "build-ai4life-prod": "ng build --configuration ai4life-production",
    "build-kmd4eosc-prod": "ng build --configuration kmd4eosc-production",
    "generate-version-file": "npx ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" version_generate.ts",
    "watch": "ng build --watch --configuration development",
    "test": "jest --verbose --coverage --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "format": "npx prettier \"src/**/*.{js,jsx,ts,tsx,html,css,scss}\" --write",
    "prepare": "husky install",
    "cy:open": "cypress open"
  },
  "private": true,
  "dependencies": {
